# ============================================================================
# Rimiris AI — .env template for production (phpMyAdmin / Hostinger / cPanel)
# ============================================================================
# Copy this file to ".env" on your server and fill in the values.
# Next.js automatically loads .env at build/start time.
#
# ⚠️  NEVER commit your real .env to git. Add it to .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) DATABASE  — fill in the credentials you created in phpMyAdmin / cPanel
# ----------------------------------------------------------------------------
# PREFERRED: use separate fields. Special chars in password are safe
# (auto URL-encoded). On shared hosting, HOST is usually "127.0.0.1" or
# "localhost", PORT is 3306.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="rimiris"
DB_PASSWORD="YourStrongPassword2026!"
DB_NAME="rimiris_prod"

# Optional tuning (defaults shown):
# DB_SSL="false"                          # set to "true" if your host enforces SSL
#                                          # (recommended on Hostinger/cPanel for MySQL 8)
# DB_SSL_ACCEPT="accept_invalid_certs"    # used with DB_SSL=true on hosts with
#                                          # self-signed certs (Hostinger, cPanel)
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL="true"    # auto-enabled when DB_SSL=false.
#                                          # Required for MySQL 8 caching_sha2_password
#                                          # over non-TLS connections. Set to "false"
#                                          # only if user is mysql_native_password.
# DB_CONNECTION_LIMIT="10"                # connection pool size

# LEGACY (optional): if you already have a working mysql:// URL, you can set
# it here instead of the DB_* fields above. If DATABASE_URL is set, it wins
# and the DB_* fields are ignored.
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DB_NAME"

# ----------------------------------------------------------------------------
# 2) SESSION + ENCRYPTION SECRETS  — generate fresh ones for production!
# ----------------------------------------------------------------------------
# Generate with:  openssl rand -hex 32   (run twice, paste each one)
# Or online:      https://generate-secret.vercel.app/32
RIMIRIS_SESSION_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"
RIMIRIS_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# Legacy aliases (some modules still read these — keep them in sync)
SESSION_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# Payment reference signing secret (used to generate tamper-proof checkout refs)
RIMIRIS_PAYMENT_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"
PAYMENT_SECRET="REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32"

# ----------------------------------------------------------------------------
# 3) PUBLIC URL — your production domain (no trailing slash)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ----------------------------------------------------------------------------
# 4) LLM PROVIDER — default is zai (free in dev sandbox).
#    Other options: openai | anthropic | mistral | openrouter | local
# ----------------------------------------------------------------------------
LLM_PROVIDER=zai
LLM_MODEL=

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Mistral (if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=

# OpenRouter (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Local / self-hosted (if LLM_PROVIDER=local)
LOCAL_BASE_URL=
LOCAL_API_KEY=
