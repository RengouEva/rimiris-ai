# ============================================================================
# Rimiris AI — Fichier .env prêt à l'emploi (backend SQLite)
# ============================================================================
# Pour Hostinger VPS — déploiement Node.js avec PM2
#
# COMMENT L'UTILISER
# ------------------
# 1. Téléchargez ce fichier.
# 2. Renommez-le en ".env" (sans rien devant).
# 3. Uploadez-le à la racine de votre projet sur le serveur :
#      /home/<votre-user>/rimiris-ai/.env
# 4. Redémarrez PM2 :  pm2 restart rimiris-ai --update-env
#
# ⚠️  NE JAMAIS committer ce fichier dans git. Il contient des secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) BASE DE DONNÉES — SQLite (fichier, aucun serveur requis)
# ----------------------------------------------------------------------------
# La DB est un simple fichier sur disque. Chemin par défaut : ./prisma/rimiris.db
# (relatif à la racine du projet).
#
# Pour Hostinger VPS, on utilise un chemin absolu hors du repo pour que la DB
# survive aux git pull / rebuild :
DB_FILE="/var/lib/rimiris/rimiris.db"

# (Optionnel) Pour forcer un chemin précis via URL Prisma brute, décommentez :
# DATABASE_URL="file:/var/lib/rimiris/rimiris.db"

# ----------------------------------------------------------------------------
# 2) SECRETS — déjà générés pour vous avec openssl rand -hex 32
# ----------------------------------------------------------------------------
# Si vous voulez régénérer : openssl rand -hex 32
RIMIRIS_SESSION_SECRET="a797bd5da7b48f7f37e50a31641296267804216c7f1b9f8fab24356ca3427c78"
RIMIRIS_ENCRYPTION_KEY="0e7ed5b00a3c7a4f538947708c5dc356d3566fc6ffe6c02d1a0b94c1bd6812d5"
RIMIRIS_PAYMENT_SECRET="50ee2d73322b97b49c210f1b892008ba88f3d31bd8224dbee98c6b494b047474"

# Alias legacy (certains modules lisent encore ces noms — garder synchronisés)
SESSION_SECRET="a797bd5da7b48f7f37e50a31641296267804216c7f1b9f8fab24356ca3427c78"
ENCRYPTION_KEY="0e7ed5b00a3c7a4f538947708c5dc356d3566fc6ffe6c02d1a0b94c1bd6812d5"
PAYMENT_SECRET="50ee2d73322b97b49c210f1b892008ba88f3d31bd8224dbee98c6b494b047474"

# ----------------------------------------------------------------------------
# 3) URL PUBLIQUE — votre domaine de production (sans slash final)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://iris.interdata.group"

# ----------------------------------------------------------------------------
# 4) PROVIDER LLM — défaut = zai (gratuit en sandbox dev)
#    Autres options : openai | anthropic | mistral | openrouter | local
# ----------------------------------------------------------------------------
LLM_PROVIDER=zai
LLM_MODEL=

# OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Mistral (si LLM_PROVIDER=mistral)
MISTRAL_API_KEY=

# OpenRouter (si LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Local / self-hosted (si LLM_PROVIDER=local)
LOCAL_BASE_URL=
LOCAL_API_KEY=

# ----------------------------------------------------------------------------
# 5) CONFIG NODE
# ----------------------------------------------------------------------------
NODE_ENV=production
TZ="Europe/Berlin"
